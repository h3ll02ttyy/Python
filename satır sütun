while True:
    try:
        n = int(input("tablo boyutunu gir (1-10): "))
        if 1 <= n <= 10:
            break
        else:
            print("1 ile 10 arasında bir sayı gir")
    except ValueError:
        print("lütfen sayı gir")

for i in range(1, n+1):
    for j in range(1, n+1):
        print(f"{i*j:4}", end="")
    print()
